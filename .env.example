# Copia este archivo como .env y llena los valores. .env NUNCA se sube al repo.

# gemini | groq | simulado
MODELO=gemini
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GROQ_API_KEY=
USAR_CACHE=1

# Base de datos: sqlserver | memoria
MODULAB_DB=sqlserver
# Usuario y contraseña de la app: los llena sql/crear_base.py (no los escribas a mano)
MODULAB_DB_SERVER=localhost
MODULAB_DB_NAME=modulab
MODULAB_DB_USER=
MODULAB_DB_PASSWORD=
